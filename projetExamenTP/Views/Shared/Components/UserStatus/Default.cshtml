@model TestWithADO.Models.Utilisateur

@if (Model != null)
{
    <span class="d-inline-flex align-items-center">
        <a class="nav-link text-dark me-2" asp-controller="Account" asp-action="Profile">
           
            Welcome, <strong>@Model.Nom @Model.Prenom</strong>!
        </a>
        <a class="nav-link text-dark" asp-controller="Account" asp-action="Logout">
            (Logout)
        </a>
    </span>
}
else
{
    <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">
        👤 Login
    </a>
}