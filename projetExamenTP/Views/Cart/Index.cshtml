@model List<TestWithADO.Models.CartItem>
@{
    ViewData["Title"] = "Shopping Cart";
    var cartTotal = Model.Sum(i => i.SubTotal);
}

<h2>Your Shopping Cart 🛒</h2>
<hr />

@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@TempData["Error"]</div>
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">Your cart is currently empty.</div>
    <a asp-controller="Home" asp-action="Products" class="btn btn-primary">Continue Shopping</a>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Product</th>
                <th>Price (DT)</th>
                <th>Quantity</th>
                <th>Subtotal (DT)</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Titre</td>
                    <td>@item.Prix.ToString("N3")</td>
                    <td>
                        <form asp-action="UpdateQuantity" asp-controller="Cart" method="post" class="d-flex">
                            <input type="hidden" name="produitId" value="@item.ProduitID" />
                            <input type="number" name="quantity" value="@item.Quantite"
                                   min="1" max="@item.MaxStock" class="form-control me-2" style="width: 80px;" />
                            <button type="submit" class="btn btn-sm btn-secondary">Update</button>
                        </form>
                    </td>
                    <td>@item.SubTotal.ToString("N3")</td>
                    <td>
                        <form asp-action="RemoveItem" asp-controller="Cart" method="post" onsubmit="return confirm('Remove @item.Titre?');">
                            <input type="hidden" name="produitId" value="@item.ProduitID" />
                            <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" class="text-end"><strong>Total:</strong></td>
                <td><strong>@cartTotal.ToString("N3") DT</strong></td>
                <td></td>
            </tr>
        </tfoot>
    </table>

    <div class="d-flex justify-content-end">
        <a asp-controller="Home" asp-action="Products" class="btn btn-secondary me-2">Continue Shopping</a>
        <a asp-action="Checkout" class="btn btn-warning">Proceed to Checkout</a>
    </div>
}