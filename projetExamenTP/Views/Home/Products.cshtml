@model IEnumerable<TestWithADO.Models.Produit>
@{
    ViewData["Title"] = "Product Catalog";
   
    var categories = (List<TestWithADO.Models.Categorie>)ViewBag.Categories;

   
    var selectedIds = (List<int>)ViewBag.SelectedCategoryIds;
    var minPrice = ViewBag.MinPrice;
    var maxPrice = ViewBag.MaxPrice;
}
<link rel="stylesheet" href="~/css/produits.css" asp-append-version="true" />


<h2 class="page-title">Product Catalog</h2>
<hr class="page-hr" />

<div class="row product-listing-row">
    <div class="col-md-3 filter-sidebar">
        <h4 class="filter-header">Filters</h4>
        <form asp-controller="Home" asp-action="Products" method="get">

            <h5 class="filter-group-title">Categories</h5>
            @foreach (var cat in categories)
            {
                <div class="form-check filter-checkbox-item">
                    <input class="form-check-input custom-checkbox"
                                         type="checkbox"
                                         name="categoryIds"
                                         value="@cat.CategorieID"
                                         id="cat-@cat.CategorieID"
                                         @if (selectedIds.Contains(cat.CategorieID))
                                       {
                        <text>checked</text>
                    }
                    >
                    <label class="form-check-label filter-label" for="cat-@cat.CategorieID">
                        @cat.Nom
                    </label>
                </div>
            }

            <h5 class="mt-4 filter-group-title">Price Range (DT)</h5>

            <input type="number"
                             name="minPrice"
                             placeholder="Min Price"
                             class="form-control filter-input mb-2"
                             value="@minPrice" />


            <input type="number"
                             name="maxPrice"
                             placeholder="Max Price"
                             class="form-control filter-input mb-3"
                             value="@maxPrice" />

            <button type="submit" class="btn apply-filter-btn">Apply Filter</button>
        </form>
    </div>

    <div class="col-md-9 product-grid-column">
        <div class="row">
            @if (!Model.Any())
            {
                <p class="alert alert-info no-results-alert">No products matched your filter criteria.</p>
            }
            @foreach (var produit in Model)
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="card product-card h-100">
                        <a asp-controller="Produit" asp-action="Details" asp-route-id="@produit.ProduitID" class="product-image-link">
                            <img src="@produit.ImagePath" class="card-img-top product-img" alt="@produit.Titre">
                        </a>

                        <div class="card-body product-card-body d-flex flex-column">
                            <h5 class="card-title product-title">
                                <a asp-controller="Produit" asp-action="Details" asp-route-id="@produit.ProduitID" class="text-decoration-none">
                                    @produit.Titre
                                </a>
                            </h5>
                            <p class="card-text product-category">@produit.CategorieNom</p>
                            <div class="mt-auto product-footer">
                                <h4 class="product-price">@produit.Prix.ToString("N3") DT</h4>

                                @if (produit.IsAvailable)
                                {
                                    <span class="badge status-available">Available</span>

                                    <form asp-action="AddToCart" asp-controller="Home" method="post" class="d-inline float-end">
                                        <input type="hidden" name="produitId" value="@produit.ProduitID" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <button type="submit" class="btn add-to-cart-btn">Add to Cart</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="badge status-out-of-stock">Out of Stock</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>