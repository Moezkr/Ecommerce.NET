@model IEnumerable<TestWithADO.Models.Produit>
@{
    ViewData["Title"] = "Manage Products";
}
<link rel="stylesheet" href="~/css/adminProducts.css" asp-append-version="true" />

<div class="admin-page-container">
    <h2 class="admin-page-title">@ViewData["Title"]</h2>
    <hr class="admin-divider" />

    <div class="row">
        <div class="col-md-3">
            <div class="admin-nav-group">
                <a asp-controller="Admin" asp-action="Dashboard" class="admin-nav-item">Dashboard Home</a>

                <a asp-controller="Produit" asp-action="Index" class="admin-nav-item active-link">Manage Products</a>

                <a asp-controller="Categorie" asp-action="Index" class="admin-nav-item">Manage Categories</a>
                <a asp-controller="Admin" asp-action="OrdersList" class="admin-nav-item">Orders List</a>
                <a asp-controller="Account" asp-action="EditProfile" class="admin-nav-item">Edit Profile</a>
            </div>
        </div>

        <div class="col-md-9 admin-content-area">

            <p class="create-product-bar">
                <a asp-action="Create" class="btn create-new-btn">Create New Product</a>
            </p>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger admin-alert-error">@TempData["Error"]</div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success admin-alert-success">@TempData["Success"]</div>
            }

            <table class="table admin-product-table">
                <thead class="table-header">
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Titre)</th>
                        <th>@Html.DisplayNameFor(model => model.Prix)</th>
                        <th>@Html.DisplayNameFor(model => model.Capacite)</th>
                        <th>@Html.DisplayNameFor(model => model.CategorieNom)</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="product-row">
                            <td class="product-title-cell">@Html.DisplayFor(modelItem => item.Titre)</td>
                            <td class="price-col">@item.Prix.ToString("N3") DT</td>
                            <td>@item.Capacite</td>
                            <td>@item.CategorieNom</td>
                            <td class="action-col">
                                <a asp-action="Edit" asp-route-id="@item.ProduitID" class="action-link edit-link">Edit</a> |

                            
                                <button type="button" class="btn btn-link action-link delete-link delete-button"
                                        data-bs-toggle="modal" data-bs-target="#confirmProductDeleteModal"
                                        data-id="@item.ProduitID" data-name="@item.Titre">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


<div class="modal fade" id="confirmProductDeleteModal" tabindex="-1" aria-labelledby="confirmProductDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="confirmProductDeleteModalLabel">Confirm Product Deletion</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete the product: <strong id="productName"></strong>?
                This action cannot be undone and will affect inventory records.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>

              
                <form id="deleteProductForm" asp-action="Delete" method="post" style="display:inline;">
                    <input type="hidden" id="productIdToDelete" name="id" value="" />
                    <button type="submit" class="btn btn-danger">Confirm Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
           
            $('#confirmProductDeleteModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var productId = button.data('id');
                var productName = button.data('name');

                var modal = $(this);
                modal.find('#productName').text(productName);

          
                modal.find('#productIdToDelete').val(productId);
            });
        });
    </script>
}