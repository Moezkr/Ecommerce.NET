@model TestWithADO.Models.Produit
@{
    ViewData["Title"] = "Edit Product";
}
<link rel="stylesheet" href="~/css/editProduct.css" asp-append-version="true" />

<div class="product-edit-container">
    <h2 class="form-page-title">@ViewData["Title"]</h2>
    <hr class="form-page-hr" />

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success form-alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger form-alert-error">@TempData["Error"]</div>
    }

    <div class="row edit-product-wrapper">

        <div class="col-md-7 edit-form-column">
            <form asp-action="Edit" method="post" enctype="multipart/form-data" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div>
                <input type="hidden" asp-for="ProduitID" />

                <h4 class="section-title">Product Details</h4>
                <hr class="section-hr" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Titre" class="form-label">Title *</label>
                        <input asp-for="Titre" class="form-control" />
                        <span asp-validation-for="Titre" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="CategorieID" class="form-label">Category *</label>
                        <select asp-for="CategorieID" class="form-control form-select" asp-items="ViewBag.Categories as SelectList"></select>
                        <span asp-validation-for="CategorieID" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control form-textarea" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Prix" class="form-label">Price (DT) *</label>
                        <input asp-for="Prix" class="form-control" type="number" step="0.001" />
                        <span asp-validation-for="Prix" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Capacite" class="form-label">Stock Quantity *</label>
                        <input asp-for="Capacite" class="form-control" type="number" />
                        <span asp-validation-for="Capacite" class="text-danger"></span>
                    </div>
                </div>

                <h4 class="section-title mt-4">Change Image</h4>
                <hr class="section-hr" />

                <div class="mb-3">
                    <label class="form-label">Change Product Image</label>
                    <input type="file" name="ImageFile" class="form-control form-file-input" accept=".jpg,.jpeg,.png,.gif" />
                    <small class="text-muted image-help-text">Leave empty to keep current image</small>
                </div>

                <div class="mb-3 button-bar mt-4">
                    <button type="submit" class="btn primary-action-btn">Save Changes</button>
                    <a asp-action="Index" class="btn secondary-action-btn">Back to List</a>
                </div>
            </form>
        </div>

        <div class="col-md-5 visual-assets-column">

            <div class="card current-image-card">
                <div class="card-header image-card-header">
                    <h5 class="card-title mb-0">Current Image Preview</h5>
                </div>
                <div class="card-body text-center image-card-body">
                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <img src="@Model.ImagePath"
                             class="img-fluid current-product-img"
                             alt="@Model.Titre"
                             onerror="this.src='/images/placeholder.jpg'; this.onerror=null;" />
                        <div class="mt-2">
                            <small class="text-muted image-path-text">Path: @Model.ImagePath</small>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted py-5 no-image-placeholder">
                            <i class="bi bi-image" style="font-size: 3rem;"></i>
                            <p class="mt-2">No image uploaded</p>
                        </div>
                    }
                </div>
            </div>

            <div class="lottie-edit-wrapper mt-4">
                
                <dotlottie-wc src="https://lottie.host/9b68cebe-cfd8-46eb-a6c5-0568e7bab9c4/oJE8pjDxPM.lottie"
                              style="width: 370px;height: 370px"
                              autoplay
                              loop></dotlottie-wc>
            </div>

        </div>
    </div>
</div>

@section Scripts {
}