@model TestWithADO.Models.Produit
@{
    ViewData["Title"] = "Create New Product";
}
<link rel="stylesheet" href="~/css/createProduct.css" asp-append-version="true" />

<div class="product-create-container">
    <h2 class="form-page-title">@ViewData["Title"]</h2>
    <hr class="form-page-hr" />

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success form-alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger form-alert-error">@TempData["Error"]</div>
    }

    <div class="row create-product-wrapper">

        <div class="col-md-7 create-form-column">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div>

                <div class="mb-3">
                    <label asp-for="Titre" class="form-label">Title *</label>
                    <input asp-for="Titre" class="form-control" placeholder="Enter product title" />
                    <span asp-validation-for="Titre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control form-textarea" rows="4" placeholder="Optional description"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Prix" class="form-label">Price (DT) *</label>
                        <input asp-for="Prix" class="form-control" type="number" step="0.001" min="0.01" placeholder="0.000" />
                        <span asp-validation-for="Prix" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Capacite" class="form-label">Stock Quantity *</label>
                        <input asp-for="Capacite" class="form-control" type="number" min="0" value="0" />
                        <span asp-validation-for="Capacite" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="CategorieID" class="form-label">Category *</label>
                    <select asp-for="CategorieID" class="form-control form-select" asp-items="ViewBag.Categories as SelectList">
                        <option value="">-- Select Category --</option>
                    </select>
                    <span asp-validation-for="CategorieID" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageFile" class="form-label">Product Image</label>
                    <input asp-for="ImageFile" type="file" class="form-control form-file-input" accept=".jpg,.jpeg,.png,.gif" />
                    <small class="text-muted image-help-text">Optional. Accepted formats: JPG, PNG, GIF</small>
                    <span asp-validation-for="ImageFile" class="text-danger"></span>
                </div>

                <div class="mb-3 button-bar mt-4">
                    <button type="submit" class="btn primary-action-btn">Create Product</button>
                    <a asp-action="Index" class="btn secondary-action-btn">Back to List</a>
                </div>
            </form>
        </div>

        <div class="col-md-5 lottie-illustration-column">
            <div class="lottie-wrapper">
             
                <dotlottie-wc src="https://lottie.host/9b68cebe-cfd8-46eb-a6c5-0568e7bab9c4/oJE8pjDxPM.lottie"
                              style="width: 600px;height: 600px"
                              autoplay
                              loop></dotlottie-wc>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}